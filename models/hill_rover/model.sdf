<?xml version="1.0"?>
<sdf version="1.10">
  <model name="hill_rover">
    <self_collide>false</self_collide>
    <!-- Route 11 start. XY comes from WGS84 projection to the world datum. -->
    <pose>-8.802 -94.620 21.046 0 0 1.000871</pose>

    <link name="base_link">
      <inertial>
        <mass>1.125</mass>
        <inertia><ixx>0.009765625</ixx><iyy>0.01806640625</iyy><izz>0.0234375</izz></inertia>
      </inertial>
      <collision name="body_collision">
        <pose>0 0 0.14 0 0 0</pose>
        <geometry><box><size>0.3875 0.2625 0.105</size></box></geometry>
      </collision>
      <visual name="body_visual">
        <pose>0 0 0.14 0 0 0</pose>
        <geometry><box><size>0.3875 0.2625 0.105</size></box></geometry>
        <material><diffuse>0.12 0.25 0.10 1</diffuse><ambient>0.08 0.15 0.06 1</ambient></material>
      </visual>
      <visual name="sensor_mast">
        <pose>0.0625 0 0.2575 0 0 0</pose>
        <geometry><cylinder><radius>0.01375</radius><length>0.1875</length></cylinder></geometry>
        <material><diffuse>0.18 0.18 0.18 1</diffuse></material>
      </visual>
      <visual name="lidar_visual">
        <pose>0.0625 0 0.3575 0 0 0</pose>
        <geometry><cylinder><radius>0.03</radius><length>0.025</length></cylinder></geometry>
        <material><diffuse>0.04 0.04 0.04 1</diffuse></material>
      </visual>
      <visual name="front_camera_visual">
        <pose>0.16 0 0.26 0 0 0</pose>
        <geometry><box><size>0.045 0.07 0.045</size></box></geometry>
        <material><diffuse>0.04 0.04 0.05 1</diffuse></material>
      </visual>
      <sensor name="imu" type="imu">
        <topic>/model/hill_rover/imu</topic><update_rate>100</update_rate><always_on>true</always_on>
      </sensor>
      <sensor name="navsat" type="navsat">
        <topic>/model/hill_rover/navsat</topic><update_rate>10</update_rate><always_on>true</always_on>
      </sensor>
      <sensor name="lidar" type="gpu_lidar">
        <pose>0.0625 0 0.3725 0 0 0</pose>
        <topic>/model/hill_rover/lidar</topic><update_rate>15</update_rate><always_on>true</always_on>
        <lidar>
          <scan>
            <horizontal><samples>720</samples><resolution>1</resolution><min_angle>-2.356</min_angle><max_angle>2.356</max_angle></horizontal>
            <vertical><samples>16</samples><resolution>1</resolution><min_angle>-0.26</min_angle><max_angle>0.26</max_angle></vertical>
          </scan>
          <range><min>0.06</min><max>45</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.005</stddev></noise>
        </lidar>
      </sensor>
      <!-- Perfect-label simulation of Meridian's front RGB-D semantic input.
           Both renderers share an optical pose, FOV, shape, and frame rate. -->
      <sensor name="semantic_camera" type="segmentation">
        <pose>0.16 0 0.26 0 0.22 0</pose>
        <topic>/model/hill_rover/semantic</topic>
        <update_rate>5</update_rate><always_on>true</always_on>
        <camera>
          <segmentation_type>semantic</segmentation_type>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image><width>320</width><height>240</height></image>
          <clip><near>0.30</near><far>8.0</far></clip>
        </camera>
      </sensor>
      <sensor name="depth_camera" type="depth_camera">
        <pose>0.16 0 0.26 0 0.22 0</pose>
        <topic>/model/hill_rover/depth</topic>
        <update_rate>5</update_rate><always_on>true</always_on>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image><width>320</width><height>240</height><format>R_FLOAT32</format></image>
          <clip><near>0.30</near><far>8.0</far></clip>
        </camera>
      </sensor>
    </link>

    <!-- Each wheel hangs off base_link through a small unsprung strut link so a
         prismatic suspension joint can give it vertical travel before the
         revolute spin joint. A cylinder spins around local Z; the -90 degree
         roll (now on the wheel link, relative to its strut) places local Z on
         model Y. -->
    <link name="front_left_strut"><pose>0.145 0.17 0.10 0 0 0</pose><inertial><mass>0.03</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz></inertia></inertial></link>
    <link name="rear_left_strut"><pose>-0.145 0.17 0.10 0 0 0</pose><inertial><mass>0.03</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz></inertia></inertial></link>
    <link name="front_right_strut"><pose>0.145 -0.17 0.10 0 0 0</pose><inertial><mass>0.03</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz></inertia></inertial></link>
    <link name="rear_right_strut"><pose>-0.145 -0.17 0.10 0 0 0</pose><inertial><mass>0.03</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz></inertia></inertial></link>

    <!-- The front suspension carries a vertical kingpin link. The wheel spins
         below that link, giving the simulation real Ackermann steering while
         retaining the four independent suspension struts. -->
    <link name="front_left_steering"><pose relative_to="front_left_strut">0 0 0 0 0 0</pose><inertial><mass>0.01</mass><inertia><ixx>0.000005</ixx><iyy>0.000005</iyy><izz>0.000005</izz></inertia></inertial></link>
    <link name="front_right_steering"><pose relative_to="front_right_strut">0 0 0 0 0 0</pose><inertial><mass>0.01</mass><inertia><ixx>0.000005</ixx><iyy>0.000005</iyy><izz>0.000005</izz></inertia></inertial></link>

    <link name="front_left_wheel"><pose relative_to="front_left_steering">0 0 0 -1.570796 0 0</pose><inertial><mass>0.109375</mass><inertia><ixx>0.00030100911</ixx><iyy>0.00030100911</iyy><izz>0.000546875</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.10</radius><length>0.055</length></cylinder></geometry><surface><friction><ode><mu>1.15</mu><mu2>0.65</mu2></ode></friction></surface></collision><visual name="visual"><geometry><cylinder><radius>0.10</radius><length>0.055</length></cylinder></geometry><material><diffuse>0.035 0.035 0.035 1</diffuse></material></visual></link>
    <link name="rear_left_wheel"><pose relative_to="rear_left_strut">0 0 0 -1.570796 0 0</pose><inertial><mass>0.109375</mass><inertia><ixx>0.00030100911</ixx><iyy>0.00030100911</iyy><izz>0.000546875</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.10</radius><length>0.055</length></cylinder></geometry><surface><friction><ode><mu>1.15</mu><mu2>0.65</mu2></ode></friction></surface></collision><visual name="visual"><geometry><cylinder><radius>0.10</radius><length>0.055</length></cylinder></geometry><material><diffuse>0.035 0.035 0.035 1</diffuse></material></visual></link>
    <link name="front_right_wheel"><pose relative_to="front_right_steering">0 0 0 -1.570796 0 0</pose><inertial><mass>0.109375</mass><inertia><ixx>0.00030100911</ixx><iyy>0.00030100911</iyy><izz>0.000546875</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.10</radius><length>0.055</length></cylinder></geometry><surface><friction><ode><mu>1.15</mu><mu2>0.65</mu2></ode></friction></surface></collision><visual name="visual"><geometry><cylinder><radius>0.10</radius><length>0.055</length></cylinder></geometry><material><diffuse>0.035 0.035 0.035 1</diffuse></material></visual></link>
    <link name="rear_right_wheel"><pose relative_to="rear_right_strut">0 0 0 -1.570796 0 0</pose><inertial><mass>0.109375</mass><inertia><ixx>0.00030100911</ixx><iyy>0.00030100911</iyy><izz>0.000546875</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>0.10</radius><length>0.055</length></cylinder></geometry><surface><friction><ode><mu>1.15</mu><mu2>0.65</mu2></ode></friction></surface></collision><visual name="visual"><geometry><cylinder><radius>0.10</radius><length>0.055</length></cylinder></geometry><material><diffuse>0.035 0.035 0.035 1</diffuse></material></visual></link>

    <joint name="front_left_suspension" type="prismatic"><parent>base_link</parent><child>front_left_strut</child><axis><xyz>0 0 1</xyz><limit><lower>-0.03</lower><upper>0.02</upper><effort>50</effort><velocity>2</velocity></limit><dynamics><damping>18</damping><spring_stiffness>400</spring_stiffness><spring_reference>0</spring_reference></dynamics></axis></joint>
    <joint name="rear_left_suspension" type="prismatic"><parent>base_link</parent><child>rear_left_strut</child><axis><xyz>0 0 1</xyz><limit><lower>-0.03</lower><upper>0.02</upper><effort>50</effort><velocity>2</velocity></limit><dynamics><damping>18</damping><spring_stiffness>400</spring_stiffness><spring_reference>0</spring_reference></dynamics></axis></joint>
    <joint name="front_right_suspension" type="prismatic"><parent>base_link</parent><child>front_right_strut</child><axis><xyz>0 0 1</xyz><limit><lower>-0.03</lower><upper>0.02</upper><effort>50</effort><velocity>2</velocity></limit><dynamics><damping>18</damping><spring_stiffness>400</spring_stiffness><spring_reference>0</spring_reference></dynamics></axis></joint>
    <joint name="rear_right_suspension" type="prismatic"><parent>base_link</parent><child>rear_right_strut</child><axis><xyz>0 0 1</xyz><limit><lower>-0.03</lower><upper>0.02</upper><effort>50</effort><velocity>2</velocity></limit><dynamics><damping>18</damping><spring_stiffness>400</spring_stiffness><spring_reference>0</spring_reference></dynamics></axis></joint>

    <joint name="front_left_steering_joint" type="revolute"><parent>front_left_strut</parent><child>front_left_steering</child><axis><xyz>0 0 1</xyz><limit><lower>-1.0471975512</lower><upper>1.0471975512</upper><effort>5</effort><velocity>6</velocity></limit><dynamics><damping>0.02</damping></dynamics></axis></joint>
    <joint name="front_right_steering_joint" type="revolute"><parent>front_right_strut</parent><child>front_right_steering</child><axis><xyz>0 0 1</xyz><limit><lower>-1.0471975512</lower><upper>1.0471975512</upper><effort>5</effort><velocity>6</velocity></limit><dynamics><damping>0.02</damping></dynamics></axis></joint>

    <joint name="front_left_joint" type="revolute"><parent>front_left_steering</parent><child>front_left_wheel</child><axis><xyz>0 0 1</xyz><limit><effort>0.703125</effort><velocity>35</velocity></limit><dynamics><damping>0.0005859375</damping></dynamics></axis></joint>
    <joint name="rear_left_joint" type="revolute"><parent>rear_left_strut</parent><child>rear_left_wheel</child><axis><xyz>0 0 1</xyz><limit><effort>0.703125</effort><velocity>35</velocity></limit><dynamics><damping>0.0005859375</damping></dynamics></axis></joint>
    <joint name="front_right_joint" type="revolute"><parent>front_right_steering</parent><child>front_right_wheel</child><axis><xyz>0 0 1</xyz><limit><effort>0.703125</effort><velocity>35</velocity></limit><dynamics><damping>0.0005859375</damping></dynamics></axis></joint>
    <joint name="rear_right_joint" type="revolute"><parent>rear_right_strut</parent><child>rear_right_wheel</child><axis><xyz>0 0 1</xyz><limit><effort>0.703125</effort><velocity>35</velocity></limit><dynamics><damping>0.0005859375</damping></dynamics></axis></joint>

    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <left_joint>front_left_joint</left_joint><left_joint>rear_left_joint</left_joint>
      <right_joint>front_right_joint</right_joint><right_joint>rear_right_joint</right_joint>
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <kingpin_width>0.34</kingpin_width>
      <!-- The plugin derives its tightest turn as wheel_base/sin(steering_limit),
           but the bicycle geometry VehicleModel plans against is
           wheel_base/tan(steer_max). Feeding the raw 0.56249793 centre angle here
           yields a 0.544 m radius instead of 0.460 m, so hard turns come out
           wider than the planner predicted. Pre-compensate with
           asin(tan(steer_max)) to land on the intended 45 deg inside wheel. -->
      <steering_limit>0.6821131963</steering_limit>
      <wheel_base>0.29</wheel_base><wheel_separation>0.34</wheel_separation><wheel_radius>0.10</wheel_radius>
      <topic>/model/hill_rover/cmd_vel</topic><odom_topic>/model/hill_rover/odometry</odom_topic>
      <frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id><odom_publish_frequency>50</odom_publish_frequency>
      <steer_p_gain>8.0</steer_p_gain>
      <!-- Gazebo applies this one limiter to BOTH linear and angular commands, so
           size it for the peak yaw demand rather than for linear speed. The
           45 deg steering limit puts that peak at 3.7 rad/s (down from 4.3), so
           this window keeps margin rather than truncating hard turns.
           Symmetry keeps negative-yaw steering from being clamped to zero; the
           wider magnitude keeps hard turns from being truncated at 2.2 rad/s.
           Neither costs anything on the linear axis: MPPI clips its own speed
           command to [0, 2.2] (core.py) before it reaches this plugin. -->
      <min_velocity>-4.4</min_velocity><max_velocity>4.4</max_velocity>
      <!-- Shared between both channels as well, so treat this as the yaw-rate
           slew bound rather than a linear one: 4.4 rad/s at 25 rad/s^2 ramps in
           0.176 s, which is where the steering joints' own 6 rad/s limit takes
           over as the binding constraint. At the old 2.46 the yaw command needed
           1.2 s to reach full turn rate, against the 0.131 s steer_tau the
           planner assumes. The linear envelope is enforced on the published
           command in gazebo_node.py, where it binds one axis only. -->
      <min_acceleration>-25</min_acceleration><max_acceleration>25</max_acceleration>
    </plugin>
  </model>
</sdf>
