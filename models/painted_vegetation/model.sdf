<?xml version="1.0"?>
<sdf version="1.10">
  <model name="painted_vegetation">
    <static>true</static>
  <link name="vegetation">
    <visual name="grass"><plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><label>50</label></plugin><geometry><mesh><uri>model://painted_vegetation/meshes/grass.obj</uri></mesh></geometry></visual>
    <visual name="bush"><plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><label>17</label></plugin><geometry><mesh><uri>model://painted_vegetation/meshes/bush.obj</uri></mesh></geometry></visual>
    <visual name="tree"><plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><label>28</label></plugin><geometry><mesh><uri>model://painted_vegetation/meshes/tree.obj</uri></mesh></geometry></visual>
    <collision name="vegetation_collision"><geometry><mesh><uri>model://painted_vegetation/meshes/collision.obj</uri></mesh></geometry></collision>

  </link>
  </model>
</sdf>
