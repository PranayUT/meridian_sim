<?xml version="1.0"?>
<sdf version="1.10">
  <model name="hill_terrain">
    <static>true</static>
    <link name="terrain">
      <collision name="terrain_collision">
        <geometry>
          <mesh><uri>model://hill_terrain/meshes/collision.obj</uri></mesh>
        </geometry>
        <surface>
          <friction><ode><mu>0.85</mu><mu2>0.75</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="terrain_visual">
        <plugin filename="gz-sim-label-system" name="gz::sim::systems::Label"><label>31</label></plugin>
        <geometry>
          <heightmap>
            <uri>model://hill_terrain/meshes/terrain.tif</uri>
            <size>512 512 65.477</size>
            <pos>0 0 -230.112</pos>
            <sampling>1</sampling>
            <texture>
              <diffuse>model://hill_terrain/materials/orthophoto.png</diffuse>
              <normal>model://hill_terrain/materials/flat_normal.png</normal>
              <size>512</size>
            </texture>
          </heightmap>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
